window-decoration=none
font-size = 18
adjust-cursor-thickness=3
background-opacity = 0.75
theme=Cutie Pro
window-padding-x=5
window-padding-y=3
command=fish
keybind = ctrl+shift+h=new_split:right
keybind = ctrl+shift+j=new_split:down
keybind = super+ctrl+j=goto_split:next
keybind = super+ctrl+k=goto_split:previous
