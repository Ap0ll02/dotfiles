// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "use_system_path_prompts": false,
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "openai",
      "model": "gpt-5"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "preferred_line_length": 92,
  "soft_wrap": "editor_width",
  "ssh_connections": [
    {
      "host": "olympus",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/jack"
          ]
        }
      ]
    }
  ],
  "restore_on_startup": "launchpad",
  "project_panel": {
    "hide_hidden": true,
  },
  "show_edit_predictions": false,
  "language_models": {
    "ollama": {
      "api_url": "https://ai.jackrat.dev",
    },
  },
  "relative_line_numbers": "enabled",
  "ui_font_family": "CodeNewRoman Nerd Font",
  "buffer_font_family": "CodeNewRoman Nerd Font Mono",
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "buffer_font_weight": 500.0,
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },
  "vim_mode": true,
  "ui_font_size": 22.0,
  "buffer_font_size": 22.0,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha (Blur)",
    "dark": "Kanagawa Wave",
  },
}
